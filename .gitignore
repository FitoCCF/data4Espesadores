# entorno
.pixi/*
!.pixi/config.toml

# checkpoints y compilados de Jupyter/Python
**/*-checkpoint.*
.ipynb_checkpoints/
__pycache__/
*.pyc
.pytest_cache/

# swaps de editor
*.swp
*.swo
*~

# configuración local (credenciales, rutas de máquina)
conf/local/*
!conf/local/.gitkeep

# generado a partir de tags.yaml::extraccion_pi para pasarlo a pi_tool.py
# (--tags-file); no es fuente de verdad, se puede regenerar en cualquier
# momento con un one-liner (ver docs/bitacora_hallazgos.md, N-8)
conf/base/tags_extraccion.txt

# datos (se versiona la estructura, no el contenido pesado)
data/00_raw/*
data/01_interim/*
data/02_primary/*
data/03_features/*
data/04_model_input/*
data/05_models/*
data/06_reporting/*
data/99_deprecated/*
!data/**/.gitkeep
!data/**/README.md

# roles de operacion (nombres/turnos de personal): no se versionan por
# privacidad, aunque el pipeline los lea localmente desde
# data/00_raw/rol_operaciones/*.md (conf/base/pipeline.yaml::roles_guardia)

# resultado del análisis, visible en GitHub: onepager + reporte de auditoría
# por espesador (el resto de data/06_reporting/ -- CSVs intermedios,
# manifiestos -- se sigue generando local y no se versiona)
!data/06_reporting/TH00*/
data/06_reporting/TH00*/*
!data/06_reporting/TH00*/onepager_*.html
!data/06_reporting/TH00*/REPORTE_COMPLETO.txt
!data/06_reporting/onepager_consolidado.html
